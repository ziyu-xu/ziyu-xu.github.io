body {
    background:url(/images/back.jpg);//图片路径
    background-repeat: no-repeat;
    background-attachment:fixed; //不重复
    background-size: cover;      //填充
    background-position:50% 50%;
		}
.post-block {
background: rgba(255,255,255,0.8) none repeat scroll !important;
}

//侧边框的透明度设置
.sidebar-inner {
background: rgba(255,255,255,0.7) none repeat scroll !important;
}


//菜单栏的透明度设置
.header-inner {
  background: rgba(255,255,255,0.8);
}

.popup {
  opacity: 0.95;
}

// 右下角黑白 QQ 音乐播放器
.aplayer.aplayer-fixed {
  right: 18px !important;
  bottom: 18px !important;
  left: auto !important;
  z-index: 9999 !important;
  font-family: Helvetica, "Helvetica Neue", Arial, "PingFang SC", "Hiragino Sans GB", "Heiti SC", sans-serif !important;
}

.aplayer.aplayer-fixed .aplayer-body,
.aplayer.aplayer-fixed .aplayer-list {
  border: 1px solid #000 !important;
  border-radius: 0 !important;
  background: #fff !important;
  box-shadow: 4px 4px 0 rgba(0, 0, 0, .22) !important;
}

.aplayer.aplayer-fixed .aplayer-info,
.aplayer.aplayer-fixed .aplayer-list ol li {
  color: #000 !important;
  background: #fff !important;
}

.aplayer.aplayer-fixed .aplayer-list ol li:hover,
.aplayer.aplayer-fixed .aplayer-list ol li.aplayer-list-light {
  color: #fff !important;
  background: #000 !important;
}

.aplayer.aplayer-fixed .aplayer-list ol li:hover .aplayer-list-author,
.aplayer.aplayer-fixed .aplayer-list ol li.aplayer-list-light .aplayer-list-author {
  color: #fff !important;
}

.aplayer.aplayer-fixed .aplayer-pic {
  filter: grayscale(1) contrast(1.05);
  border-radius: 0 !important;
}

.aplayer.aplayer-fixed .aplayer-icon {
  color: #000 !important;
}

.aplayer.aplayer-fixed .aplayer-miniswitcher {
  right: 0 !important;
  left: auto !important;
  border: 1px solid #000 !important;
  border-radius: 0 !important;
  background: #fff !important;
}

@media (max-width: 720px) {
  .aplayer.aplayer-fixed {
    right: 10px !important;
    bottom: 10px !important;
  }
}
